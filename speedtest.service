[Unit]
Description=wberg networks speedtest
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/speedtest -domain speedtest.example.net
Restart=on-failure
DynamicUser=yes
StateDirectory=speedtest
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
